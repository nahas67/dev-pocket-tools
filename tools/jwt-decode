#!/usr/bin/env python3
"""Decode and display a JWT's header and payload (never verifies signature)."""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dptlib import jwt  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="jwt-decode",
        description="Decode a JSON Web Token for debugging (no signature verification).",
    )
    parser.add_argument("token", nargs="?", help="the JWT string (default: stdin)")
    parser.add_argument("--redact", action="store_true", help="only print a redacted preview")
    parser.add_argument("--raw", action="store_true", help="print the decoded object as JSON")
    args = parser.parse_args(argv)

    token = args.token
    if token is None:
        token = sys.stdin.read().strip() if not sys.stdin.isatty() else ""
    if not token:
        print("No token supplied (pass it as an argument or on stdin).", file=sys.stderr)
        return 1

    if args.redact:
        print(jwt.redact(token))
        return 0

    try:
        decoded = jwt.decode(token)
    except ValueError as exc:
        print(f"jwt-decode: {exc}", file=sys.stderr)
        return 1

    view = {
        "header": decoded["header"],
        "payload": decoded["payload"],
        "signature": (
            decoded["signature"].hex() if decoded["signature"] else ""
        ),
        "is_expired": decoded["is_expired"],
    }

    if args.raw:
        print(json.dumps(view, indent=2, sort_keys=True))
        return 0

    print("HEADER:")
    print(json.dumps(decoded["header"], indent=2, sort_keys=True))
    print("\nPAYLOAD:")
    print(json.dumps(decoded["payload"], indent=2, sort_keys=True))
    print(f"\nSIGNATURE (hex): {view['signature'] or '<none>'}")
    expired = decoded["is_expired"]
    state = "unknown (no exp claim)" if expired is None else ("EXPIRED" if expired else "valid")
    print(f"EXPIRY: {state}")
    print("\nNote: signature was NOT verified.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
