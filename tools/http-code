#!/usr/bin/env python3
"""Look up HTTP status codes or list all known codes."""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dptlib import httpcode  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="http-code",
        description="Look up an HTTP status code, or list all known codes.",
    )
    parser.add_argument("code", nargs="*", help="one or more status codes (e.g. 200 404)")
    parser.add_argument("--list", action="store_true", help="list every known code")
    args = parser.parse_args(argv)

    if args.list or not args.code:
        for code in httpcode.all_codes():
            info = httpcode.lookup(code)
            assert info is not None
            print(f"{code}  {info['title']:<32} {info['category']}")
        return 0

    missing = False
    for raw in args.code:
        info = httpcode.lookup(raw)
        if info is None:
            print(f"Unknown HTTP code: {raw}", file=sys.stderr)
            missing = True
            continue
        print(f"{info['code']} {info['title']} [{info['category']}]")
        print(f"  {info['description']}")
    return 1 if missing else 0


if __name__ == "__main__":
    raise SystemExit(main())
