#!/usr/bin/env python3
"""List safe-to-delete local git branches and their delete commands.

Reads ``git branch`` output from ``--input`` (or stdin), or runs ``git branch``
in the current directory when no input is given.  Never deletes anything
unless ``--execute`` is explicitly passed.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dptlib import gitbranches  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="git-clean-branches",
        description="Classify local branches and build safe delete commands.",
    )
    parser.add_argument("--input", "-i", help="file with `git branch` output (default: run git)")
    parser.add_argument(
        "--protected", default=",".join(gitbranches.DEFAULT_PROTECTED),
        help="comma-separated protected names/globs (default: main,master,develop,development)",
    )
    parser.add_argument("--execute", action="store_true", help="actually run delete commands")
    parser.add_argument("--yes", action="store_true", help="skip confirmation with --execute")
    args = parser.parse_args(argv)

    if args.input:
        with open(args.input, "r", encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        try:
            result = subprocess.run(
                ["git", "branch", "--no-color"],
                capture_output=True, text=True, check=True,
            )
            text = result.stdout
        except (OSError, subprocess.CalledProcessError) as exc:
            print(f"git-clean-branches: could not run git branch: {exc}", file=sys.stderr)
            return 1

    if not text.strip():
        print("No branch output to process.", file=sys.stderr)
        return 1

    branches = gitbranches.parse_branch_lines(text)
    if not branches:
        print("No branches found.")
        return 0

    protected = [p.strip() for p in args.protected.split(",") if p.strip()]
    current = next((b["name"] for b in branches if b.get("current")), "")
    for branch in branches:
        branch["protected"] = protected

    print("BRANCH CLASSIFICATION:")
    for branch in branches:
        label = gitbranches.classify(branch, current, protected)
        print(f"  {label:<10} {branch['name']}")

    commands = gitbranches.build_delete_commands(branches, dry_run=not args.execute)
    print("\nDELETE COMMANDS:")
    if not commands:
        print("  (none)")
        return 0
    for cmd in commands:
        print(f"  {cmd}")

    if args.execute:
        if not args.yes:
            answer = input("Run the commands above? [y/N] ").strip().lower()
            if answer not in ("y", "yes"):
                print("Aborted.")
                return 0
        rc = 0
        for branch in branches:
            if gitbranches.classify(branch, current, protected) != "deletable":
                continue
            result = subprocess.run(["git", "branch", "-d", branch["name"]])
            if result.returncode != 0:
                rc = 1
        return rc
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except OSError as exc:
        print(f"git-clean-branches: {exc}", file=sys.stderr)
        raise SystemExit(1)
