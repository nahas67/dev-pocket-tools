#!/usr/bin/env python3
"""Explain a five-field cron expression in plain English."""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dptlib import cron  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="cron-explain",
        description="Expand and explain a 5-field cron expression.",
    )
    parser.add_argument("expr", nargs="?", help="cron expression, e.g. '*/5 * * * *'")
    parser.add_argument("--json", action="store_true", help="print expanded fields as JSON")
    args = parser.parse_args(argv)

    expr = args.expr
    if expr is None:
        expr = sys.stdin.read().strip() if not sys.stdin.isatty() else ""
    if not expr:
        print("No cron expression supplied.", file=sys.stderr)
        return 1

    try:
        if args.json:
            print(json.dumps(cron.describe(expr), indent=2, sort_keys=True))
        else:
            print(cron.explain(expr))
    except ValueError as exc:
        print(f"cron-explain: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
